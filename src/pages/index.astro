    event: "https://www.meetup.com/Toledo-Web-Professionals/events/222335600/",
    links: [
      [
        "LinkedIn",
        "https://www.linkedin.com/in/michaellhess/",
        "linkedin",
      ],
    ],
  },
  {
    image: ryanPhoto,
    name: "Ryan Lanciaux",
    talk: "React Mini-Workshop",
    event: "https://www.meetup.com/Toledo-Web-Professionals/events/228736974/",
