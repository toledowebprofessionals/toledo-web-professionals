    links: [
      [
        "LinkedIn",
        "https://www.linkedin.com/in/dave-rodriguez-5ab4953/",
        "linkedin",
      ],
      ["Website", "http://ohiodave.com", "link"],
    ],
  },
  {
    image: selwynPhoto,
    name: "Selwyn Kancharla",
    talk: "Life Lessons: What Dashboard Design Taught Me",
    event: "https://www.meetup.com/Toledo-Web-Professionals/events/220945174/",
    links: [
      [
        "LinkedIn",
        "https://www.linkedin.com/in/selwynjacob90/",
        "linkedin",
      ],
    ],
  },
  {
    image: merrillPhoto,
    name: "Merrill Rainey",
    talk: "Get Out of Your Design Cave",
    event: "https://www.meetup.com/Toledo-Web-Professionals/events/92856562/",
    links: [
      [
        "LinkedIn",
        "https://www.linkedin.com/in/merrill-rainey-0a1a8210/",
        "linkedin",
