---
import SiteLayout from "../layouts/SiteLayout.astro";
import GetConnected from "../components/GetConnected.astro";
import AboutContent from "../components/AboutContent.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import { Image } from "astro:assets";
import nickPhoto from "../assets/img/speakers/nick-denardis.jpg";
