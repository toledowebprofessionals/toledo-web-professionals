---
import SiteLayout from "../layouts/SiteLayout.astro";
import ServiceYears from "../components/ServiceYears.astro";
import { Image } from "astro:assets";
import Icon, { type IconName } from "../components/Icon.astro";
import event1 from "../assets/img/events/toledo-web-pro-event-1.png";
import event2 from "../assets/img/events/toledo-web-pro-event-2.png";
import event3 from "../assets/img/events/toledo-web-pro-event-3.png";
import event4 from "../assets/img/events/toledo-web-pro-event-4.png";
import event5 from "../assets/img/events/toledo-web-pro-event-5.png";
import event6 from "../assets/img/events/toledo-web-pro-event-6.png";
import event7 from "../assets/img/events/toledo-web-pro-event-7.png";

const benefits = [
  {
    icon: "handshake",
    title: "Bring the Community In",
    description:
      "Welcome Toledo’s technology community into your workplace and create new connections with local professionals, collaborators, and future talent.",
  },
  {
    icon: "lightbulb",
    title: "Share What You Know",
    description:
      "Give your team a platform to share useful expertise, interesting projects, hard-earned lessons, and ideas worth discussing.",
  },
  {
    icon: "building",
    title: "Show People Your Work",
    description:
      "Offer attendees a behind-the-scenes look at your organization, your culture, and the people doing meaningful work in Toledo.",
  },
  {
    icon: "heart",
    title: "Support Local Tech",
    description:
      "Help us keep community events welcoming and free while investing directly in learning, connection, and Toledo’s technology ecosystem.",
  },
];

const numbers = [
  "600+ registered members on Meetup.com",
  "An average of 25–40 attendees at each event",
  "Social media reach of 1,000+ monthly impressions",
  "Mailing list reach of 600+ individuals",
];
---

<SiteLayout
  title="Sponsor a Talk | Toledo Web Professionals"
  description="Host a Toledo Web Professionals talk and connect your organization with Toledo’s technology community."
  path="/sponsor-a-talk/"
>
  <section class="twp-gradient twp-grid-animated overflow-hidden pt-20 text-white">
    <div
      class="mx-auto grid min-h-[calc(100vh-5rem)] max-w-6xl items-center gap-12 px-5 py-16 lg:grid-cols-2 lg:px-8"
    >
      <div class="max-w-xl">
        <p class="mb-4 text-lg font-bold uppercase tracking-[0.15em]">
          Open Your Doors
        </p>
        <h1 class="text-5xl font-bold leading-[0.95] sm:text-6xl">
          Sponsor a Talk
        </h1>
        <p class="mt-7 text-xl font-bold leading-relaxed">
          Bring Toledo’s tech community into your space and give your team a
          chance to share the work, knowledge, and ideas that move our region
          forward.
        </p>
        <a
          class="mt-8 inline-block border-2 border-white px-8 py-4 font-bold text-white transition hover:bg-white hover:text-twp-orange"
          href={`mailto:shout@twpmeetup.com?subject=${encodeURIComponent("Sponsor a Toledo Web Professionals talk")}`}
        >
          Sponsor a Talk
        </a>
      </div>

      <div
        class="origin-left rotate-2 rounded-lg bg-white p-3 shadow-2xl lg:w-[135%] xl:w-[145%]"
      >
        <Image
          class="aspect-[4/3] w-full rounded object-cover"
          src={event3}
          alt="A Toledo Web Professionals event at Menlo Innovations"
          widths={[400, 640, 800, 1200]}
          sizes="(min-width: 1024px) 60vw, 100vw"
          format="webp"
          quality="mid"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-normal leading-tight text-zinc-700 sm:text-4xl">
          Put your space and expertise at the center of the conversation.
        </h2>
        <p class="mt-6 leading-relaxed">
          Sponsoring a talk is a simple, meaningful way to showcase your work,
          support local talent, and build genuine relationships with the people
          helping shape Toledo’s future.
        </p>
      </div>

      <div class="mt-14 grid gap-x-16 gap-y-12 sm:grid-cols-2">
          {
            benefits.map((benefit) => (
              <article>
                <Icon
                  name={benefit.icon as IconName}
                  class="mb-5 text-3xl text-twp-orange"
                />
                <h3 class="text-xl font-bold text-twp-pink">{benefit.title}</h3>
                <p class="mt-3 leading-relaxed">{benefit.description}</p>
              </article>
            ))
          }
      </div>
    </div>
  </section>

  <section class="bg-zinc-100 py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="mb-12 max-w-4xl">
        <h2 class="text-3xl font-normal text-zinc-700 sm:text-4xl">
          Create an experience people remember.
        </h2>
        <p class="mt-5 text-lg leading-relaxed">
          Host a talk, tour, workshop, or panel at your office, studio, or
          workplace. We’ll collaborate with your team to shape the topic,
          organize the details, promote the event, and welcome the community.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-3">
        <Image
          class="aspect-[4/3] w-full rounded-lg object-cover"
          src={event1}
          alt="A presentation at a Toledo Web Professionals event"
          width={400}
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
        <Image
          class="aspect-[4/3] w-full rounded-lg object-cover"
          src={event7}
          alt="Community members gathered for a technology workshop"
          width={400}
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
        <Image
          class="aspect-[4/3] w-full rounded-lg object-cover"
          src={event4}
          alt="Professionals networking at a Toledo Web Professionals event"
          width={400}
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
        <Image
          class="aspect-[4/3] w-full rounded-lg object-cover"
          src={event2}
          alt="A speaker sharing their experience with the community"
          width={400}
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
        <Image
          class="aspect-[4/3] w-full rounded-lg object-cover"
          src={event5}
          alt="Toledo professionals participating in a local technology event"
          width={400}
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
        <Image
          class="aspect-[4/3] w-full rounded-lg object-cover"
          src={event6}
          alt="Community members learning together at a workshop"
          width={400}
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-28">
    <div
      class="mx-auto grid max-w-6xl items-center gap-16 px-5 md:grid-cols-2 lg:px-8"
    >
      <div>
        <p class="mb-3 font-bold uppercase tracking-[0.12em] text-twp-orange">
          Community Reach
        </p>
        <h2 class="mb-8 text-3xl font-normal text-zinc-700 sm:text-4xl">
          Toledo Web Professionals by the Numbers
        </h2>
        <ul class="space-y-3">
          <li class="flex gap-4 leading-relaxed">
            <Icon name="check" class="mt-1 text-twp-orange" />
            <span>Founded in October 2011</span>
          </li>
          <li class="flex gap-4 leading-relaxed">
            <Icon name="check" class="mt-1 text-twp-orange" />
            <span>Hundreds of events held over <ServiceYears /> years</span>
          </li>
          {
            numbers.map((number) => (
              <li class="flex gap-4 leading-relaxed">
                <Icon name="check" class="mt-1 text-twp-orange" />
                <span>{number}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="self-center rounded-lg border-2 border-twp-pink bg-white p-8 sm:p-10"
      >
        <h2 class="text-3xl font-bold text-twp-pink">Ready to Get Started?</h2>
        <p class="mt-5 text-lg leading-relaxed">
          Reach out to a member of our leadership team, and we’ll help customize
          your sponsored event experience. We can’t wait to connect you to
          Toledo’s premier technology community!
        </p>
        <a
          class="mt-8 inline-block border-2 border-twp-orange px-7 py-3 font-bold text-twp-orange transition hover:bg-twp-orange hover:text-white"
          href={`mailto:shout@twpmeetup.com?subject=${encodeURIComponent("Sponsor a Toledo Web Professionals talk")}`}
        >
          Contact Our Team
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
